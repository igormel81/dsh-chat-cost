{
  "name": "dsh-chat-cost",
  "version": "0.5.4",
  "description": "DeepSeek Harness (dsh) plugin: live token cost of every chat, its subagents and the whole session tree, budget planning that packs a work plan under a money limit, and scenario comparison that names which models are worth connecting — DeepSeek, OpenAI, Anthropic, Gemini, Kimi, Grok and Mistral prices from a bundled catalog, plus a JSONL cost log in your project folder.",
  "keywords": [
    "anthropic",
    "budget",
    "budgeting",
    "cache-read",
    "cache-write",
    "claude",
    "cordis",
    "cost",
    "cost-log",
    "cost-optimization",
    "cost-planning",
    "cost-tracking",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "gemini",
    "google",
    "gpt-5",
    "grok",
    "jsonl",
    "kimi",
    "llm-pricing",
    "local-first",
    "mistral",
    "model-routing",
    "model-selection",
    "moonshot",
    "observability",
    "openai",
    "peak-pricing",
    "plan-vs-actual",
    "price",
    "pricing",
    "provider-comparison",
    "scenario-planning",
    "session-tree",
    "spend",
    "spend-control",
    "subagent",
    "token-budget",
    "token-cost",
    "token-usage",
    "tokens",
    "usage",
    "xai"
  ],
  "license": "MIT",
  "author": "igormel81 <igor.melnikov@gmail.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "data",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.ru.md",
    "README.i18n.yaml",
    "LICENSE",
    "scripts",
    "test"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prices": "node scripts/build-prices.mjs",
    "prices:all": "node scripts/build-prices.mjs --all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igormel81/dsh-chat-cost.git"
  },
  "homepage": "https://github.com/igormel81/dsh-chat-cost#readme",
  "bugs": {
    "url": "https://github.com/igormel81/dsh-chat-cost/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
